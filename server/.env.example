PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://localhost:27017/taskflow
SESSION_TTL_HOURS=168
CORS_ORIGINS=http://localhost:5173
TRUST_PROXY=0

# Google OAuth Web application client ID; must match VITE_GOOGLE_CLIENT_ID.
# Setup: docs/google-sign-in.md (no client secret required for this flow).
GOOGLE_CLIENT_ID=
# Canonical frontend origin used in emailed links (exact HTTPS origin in production).
APP_ORIGIN=http://localhost:5173
# Development Mailpit: docker compose up -d mailpit, inbox http://localhost:8025
# Production: set your SMTP provider, sender, and credentials. TLS is required.
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=noreply@taskflow.local
